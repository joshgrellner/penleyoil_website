# Analytics (Required for tracking)
# Get your GA4 ID from: https://analytics.google.com → Admin → Data Streams → your stream
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Get your GTM ID from: https://tagmanager.google.com → your container
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console Verification
# Get from: https://search.google.com/search-console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Maps Embed API Key (Required for contact page map)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable "Maps Embed API" and restrict the key to your domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chatbot (optional)
NEXT_PUBLIC_CHATBOT_PROVIDER=openai
NEXT_PUBLIC_CHATBOT_KEY=your_api_key_here

# RAG Configuration
RAG_SITE_URL=https://www.penleyoil.com
RAG_MAX_PAGES=500

# Admin Backoffice (credit applications & media review)
# Server-only password for /admin/credit-applications and /admin/media-review.
# Do NOT use a NEXT_PUBLIC_ prefix — that would expose it in the browser bundle.
# Changing this password immediately logs out all active admin sessions.
ADMIN_PASSWORD=choose-a-strong-password
